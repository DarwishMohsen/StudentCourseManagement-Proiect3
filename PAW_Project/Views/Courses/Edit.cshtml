@model PAW_Project.Models.Course

@{
    ViewData["Title"] = "Edit";
}

<div class="container mt-4">
    <h1 class="text-primary">Editare Curs</h1>
    <h4>@(Model?.Name ?? "Curs")</h4>
    <hr />
    
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="CourseID" />

                <div class="form-group mb-3">
                    <label asp-for="Name" class="control-label fw-bold"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Year" class="control-label fw-bold"></label>
                            <input asp-for="Year" class="form-control" />
                            <span asp-validation-for="Year" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Semester" class="control-label fw-bold"></label>
                            <input asp-for="Semester" class="form-control" />
                            <span asp-validation-for="Semester" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                
                <div class="form-group mb-3">
                    <label class="control-label fw-bold">Profesori Alocați</label>
                    <select name="professorIds" class="form-select" multiple asp-items="@(ViewBag.Professors as MultiSelectList)"></select>
                    <small class="text-muted">CTRL + Click pentru selecție multiplă.</small>
                </div>
                
                <div class="form-group mb-4">
                    <label class="control-label fw-bold">Sală Curs</label>
                    <select name="roomId" class="form-select" asp-items="@(ViewBag.Rooms as SelectList)">
                        <option value="">-- Schimbă sala --</option>
                    </select>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary shadow-sm">Salvează Modificările</button>
                    <a asp-action="Index" class="btn btn-outline-secondary ms-2">Înapoi la Listă</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}