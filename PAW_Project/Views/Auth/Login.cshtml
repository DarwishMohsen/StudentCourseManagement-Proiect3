@model PAW_Project.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Login</h3>
                </div>
                <div class="card-body">
                    <form asp-controller="Auth" asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold text-dark">Email</label>
                            <input asp-for="Email" class="form-control" placeholder="Introdu adresa de email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-bold text-dark">Parola</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Introdu parola" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        
                        <button type="submit" class="btn btn-primary w-100 fw-bold">Intră în cont</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>