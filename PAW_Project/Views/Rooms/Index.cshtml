@model IEnumerable<PAW_Project.Models.Room>

@{
    ViewData["Title"] = "Index";
}

<h1>Rooms Management</h1>

<p>
    <a asp-action="Create" class="btn btn-success shadow-sm">Adaugă Sală Nouă</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Building)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Building)
            </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.RoomID" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.RoomID" class="btn btn-sm btn-outline-info">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.RoomID" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
        </tr>
}
    </tbody>
</table>
