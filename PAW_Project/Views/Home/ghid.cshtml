@{
    ViewData["Title"] = "Ghid Student";
}
<header class="guide-header mb-5">
    <div class="container">
        <h1 class="display-4 fw-bold">Ghidul Studentului</h1>
        <p class="lead">Tot ce trebuie să știi despre regulamentele și sistemul de notare al facultății.</p>
    </div>
</header>

<main class="container">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card info-card h-100 p-4 shadow-sm">
                <h4 class="text-primary mb-3">Sistemul de Notare</h4>
                <p>Evaluarea se face pe o scară de la <strong>1 la 10</strong>.</p>
                <ul>
                    <li><strong>10 - 9:</strong> Excelent / Foarte Bine</li>
                    <li><strong>8 - 7:</strong> Bine</li>
                    <li><strong>6 - 5:</strong> Satisfăcător</li>
                    <li><strong>Sub 5:</strong> Respins (Restanță)</li>
                </ul>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card info-card h-100 p-4 shadow-sm" style="border-top-color: #198754;">
                <h4 class="text-success mb-3">Credite ECTS</h4>
                <p>Un an universitar standard are <strong>60 de credite</strong>.</p>
                <div class="alert alert-success py-2">
                    Media creditelor este necesară pentru obținerea bursei.
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card info-card h-100 p-4 shadow-sm" style="border-top-color: #dc3545;">
                <h4 class="text-danger mb-3">Reguli Laborator</h4>
                <p>Prezența la laboratoare este, în general, <strong>obligatorie (100%)</strong>.</p>
                <ul>
                    <li>Laboratoarele se desfășoară în sălile specifice (K206, G116 etc).</li>
                </ul>
            </div>
        </div>
    </div>
</main>