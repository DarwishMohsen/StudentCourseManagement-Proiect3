@model IEnumerable<PAW_Project.Models.Course>

@{
    ViewData["Title"] = "Catalog Cursuri";
}

<main class="container">
    <h2 class="text-center mb-5">Catalogul de Cursuri</h2>
    <div class="row g-4">
        @foreach (var course in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center d-flex flex-column">
                        <h5 class="card-title fw-bold">@course.Name</h5>
                        <p class="card-text text-muted small flex-grow-1">
                            Profesor: @(course.Professors != null && course.Professors.Any() ? string.Join(", ", course.Professors.Select(p => p.LastName)) : "TBD")
                        </p>
                        
                        <div class="mt-3">
                            <a asp-controller="Home" asp-action="Detalii" asp-route-id="@course.CourseID" class="btn btn-outline-primary btn-sm w-100 mb-2">Detalii</a>

                            @if (User.IsInRole("Admin"))
                            {
                                <div class="d-grid gap-2">
                                    <a asp-controller="Courses" asp-action="Edit" asp-route-id="@course.CourseID" class="btn btn-warning btn-sm">Editează</a>
                                    <a asp-controller="Courses" asp-action="Delete" asp-route-id="@course.CourseID" class="btn btn-danger btn-sm">Șterge</a>
                                </div>
                            }

                            @if (User.IsInRole("Student"))
                            {
                                <form asp-controller="Home" asp-action="ProcessInscriere" method="post">
                                    <input type="hidden" name="courseId" value="@course.CourseID" />
                                    <button type="submit" class="btn btn-success btn-sm w-100">Înscrie-te</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</main>