@{
    ViewData["Title"] = "Înscriere";
}

<main class="container my-5">
    <h2>Formular de Înscriere</h2>
    <form asp-action="ProcessInscriere" method="post" class="mt-4 shadow p-4 rounded bg-light">
        <div class="mb-3">
            <label class="form-label">CNP</label>
            <input type="text" name="cnp" class="form-control" required>
        </div>
        <div class="mb-3">
            <label class="form-label">Nume</label>
            <input type="text" name="nume" class="form-control" required>
        </div>
        <div class="mb-3">
            <label class="form-label">Prenume</label>
            <input type="text" name="prenume" class="form-control" required>
        </div>
        <div class="mb-3">
            <label class="form-label">Selectați Cursul</label>
            <select name="courseId" class="form-select">
                @foreach (var c in ViewBag.Courses)
                {
                    <option value="@c.CourseID">@c.Name</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-success">Trimite Înscrierea</button>
    </form>
</main>