@{
    ViewData["Title"] = "FAQ";
}
<main class="container my-5">
    <h2 class="mb-4">Întrebări Frecvente</h2>
    <div class="accordion" id="mainFaq">
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne">
                    Cum obțin parola de student?
                </button>
            </h2>
            <div id="collapseOne" class="accordion-collapse collapse" data-bs-parent="#mainFaq">
                <div class="accordion-body">Parola se primește prin email la înmatriculare.</div>
            </div>
        </div>
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo">
                    Cine a creat website-ul?
                </button>
            </h2>
            <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#mainFaq">
                <div class="accordion-body">Website-ul a fost creat de Mohsen Darwish pentru proiectul de lab.</div>
            </div>
        </div>
    </div>
</main>