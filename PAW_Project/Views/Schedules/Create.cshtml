@model PAW_Project.Models.Schedule

@{
    ViewData["Title"] = "Adaugă Orar";
}

<div class="container mt-4">
    <div class="card shadow-sm border-primary">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Adaugă Programare Nouă</h3>
        </div>
        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-6">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        
                        <div class="form-group mb-3">
                            <label asp-for="Date" class="control-label fw-bold">Data</label>
                            <input asp-for="Date" class="form-control shadow-sm" type="date" />
                            <span asp-validation-for="Date" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Hour" class="control-label fw-bold">Ora (ex: 10:00)</label>
                            <input asp-for="Hour" class="form-control shadow-sm" placeholder="HH:mm" />
                            <span asp-validation-for="Hour" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="CourseID" class="control-label fw-bold">Selectați Cursul</label>
                            <select asp-for="CourseID" class="form-select shadow-sm" asp-items="ViewBag.CourseID">
                                <option value="">-- Alegeți un Curs --</option>
                            </select>
                            <span asp-validation-for="CourseID" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-success shadow-sm px-4">
                                <i class="bi bi-check-circle"></i> Salvează
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm ms-2">Înapoi la Listă</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}