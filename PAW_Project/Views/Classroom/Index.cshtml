@model PAW_Project.Models.Course
@{
    ViewData["Title"] = Model.Name + " - Classroom";
    bool isCourseProfessor = ViewBag.IsCourseProfessor == true;
}

<div class="container mt-4">
    <!-- Course Header Banner -->
    <div class="p-4 mb-4 rounded-3 bg-primary text-white shadow-sm">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold mb-1">@Model.Name</h2>
                <p class="mb-0">An @Model.Year • Semestrul @Model.Semester</p>
            </div>
            <a asp-controller="Courses" asp-action="Index" class="btn btn-light btn-sm">Înapoi la Cursuri</a>
        </div>
    </div>

    <div class="row">
        <!-- Left Column: Announcements Stream -->
        <div class="col-md-8">
            <h4 class="mb-3">📢 Anunțuri Curs</h4>

            @if (isCourseProfessor)
            {
                <div class="card shadow-sm mb-4 border-primary">
                    <div class="card-body">
                        <h6 class="fw-bold text-primary mb-3">Publică un anunț nou</h6>
                        <form asp-action="PostAnnouncement" method="post">
                            <input type="hidden" name="courseId" value="@Model.CourseID" />
                            <div class="mb-2">
                                <input type="text" name="title" class="form-control" placeholder="Titlu anunț..." required />
                            </div>
                            <div class="mb-2">
                                <textarea name="content" class="form-control" rows="3" placeholder="Scrie un anunț pentru studenți..." required></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">Publică Anunț</button>
                        </form>
                    </div>
                </div>
            }

            @if (Model.Announcements != null && Model.Announcements.Any())
            {
                @foreach (var ann in Model.Announcements.OrderByDescending(a => a.CreatedAt))
                {
                    <div class="card shadow-sm mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <h5 class="card-title fw-bold mb-1">@ann.Title</h5>
                                <small class="text-muted">@ann.CreatedAt.ToString("dd MMM yyyy, HH:mm")</small>
                            </div>
                            <small class="text-muted d-block mb-2">Postat de: @(ann.Author?.UserName ?? "Profesor")</small>
                            <p class="card-text">@ann.Content</p>

                            <hr />
                            <!-- Public Comments on this Announcement -->
                            <div class="ms-2">
                                <small class="fw-bold text-secondary">Comentarii (@ann.Comments.Count)</small>
                                @foreach (var cm in ann.Comments.OrderBy(c => c.CreatedAt))
                                {
                                    <div class="bg-light rounded p-2 my-2">
                                        <div class="d-flex justify-content-between">
                                            <strong class="small">@(cm.Author?.UserName ?? "Utilizator")</strong>
                                            <small class="text-muted">@cm.CreatedAt.ToString("dd MMM, HH:mm")</small>
                                        </div>
                                        <div class="small">@cm.Content</div>
                                    </div>
                                }

                                <form asp-action="PostAnnouncementComment" method="post" class="d-flex gap-2 mt-2">
                                    <input type="hidden" name="courseId" value="@Model.CourseID" />
                                    <input type="hidden" name="announcementId" value="@ann.AnnouncementID" />
                                    <input type="text" name="content" class="form-control form-control-sm" placeholder="Adaugă un comentariu la anunț..." required />
                                    <button type="submit" class="btn btn-outline-primary btn-sm">Trimite</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-light border text-muted">Nu există anunțuri încă pentru acest curs.</div>
            }
        </div>

        <!-- Right Column: Quick Links (Materials/Assignments) & General Course Comments -->
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white fw-bold">📚 Resurse Curs</div>
                <div class="card-body">
                    <p class="small text-muted mb-2">Materiale încărcate: <strong>@Model.Materials.Count</strong></p>
                    <p class="small text-muted mb-0">Teme active: <strong>@Model.Assignments.Count</strong></p>
                    <small class="text-muted fst-italic d-block mt-2">(Urmează în Pasul 4 & 5)</small>
                </div>
            </div>

            <!-- General Public Course Comments -->
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white fw-bold">💬 Discuții Generale Curs</div>
                <div class="card-body">
                    @if (Model.Comments != null && Model.Comments.Any())
                    {
                        @foreach (var cm in Model.Comments.OrderByDescending(c => c.CreatedAt))
                        {
                            <div class="border-bottom pb-2 mb-2">
                                <div class="d-flex justify-content-between">
                                    <strong class="small">@(cm.Author?.UserName ?? "Utilizator")</strong>
                                    <small class="text-muted">@cm.CreatedAt.ToString("dd MMM, HH:mm")</small>
                                </div>
                                <div class="small">@cm.Content</div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="small text-muted">Niciun comentariu încă.</p>
                    }

                    <form asp-action="PostCourseComment" method="post" class="mt-3">
                        <input type="hidden" name="courseId" value="@Model.CourseID" />
                        <div class="input-group input-group-sm">
                            <input type="text" name="content" class="form-control" placeholder="Scrie un comentariu public..." required />
                            <button type="submit" class="btn btn-primary">Trimite</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>